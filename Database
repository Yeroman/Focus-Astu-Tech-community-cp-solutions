-- to see transfer records
SELECT 
    tr.transfer_id,
    c1.first_name AS sender_name,
    c2.first_name AS receiver_name,
    tr.amount
FROM Transferdb tr
JOIN Accountdb a1 ON tr.from_account = a1.account_id
JOIN Customerdb c1 ON a1.customer_id = c1.customer_id
JOIN Accountdb a2 ON tr.to_account = a2.account_id
JOIN Customerdb c2 ON a2.customer_id = c2.customer_id;

